# conditions.sai - making decisions with 'when' and 'otherwise'
make age = 10

when age >= 13 {
    say "Teen mode"
} otherwise when age >= 10 {
    say "Ready for the next level!"
} otherwise {
    say "Not ready yet."
}

when age == 10 and not (age > 20) {
    say "Age is exactly 10 and not over 20"
}
